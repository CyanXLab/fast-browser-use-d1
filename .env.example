# Default stack: LiquidAI d1-3B decision model on CPU through llama.cpp.
FBU_BACKEND=llamacpp
# llama.cpp server endpoint; fbu auto-starts llama-server on first use when idle.
FBU_LLAMACPP_URL=http://127.0.0.1:8765
# Path to the d1 GGUF weights (download with `fbu download`):
# FBU_MODEL=/absolute/path/to/d1-3B-Q4_K_M.gguf
# llama-server launch knobs: KV prefix cache for the chat/plan/text endpoint and
# cross-request chunk reuse. Note: LFM2 hybrid memory cannot reuse KV across
# decision requests (llama.cpp limitation); these still speed up text generation.
FBU_LLAMACPP_CACHE_REUSE=256
FBU_LLAMACPP_CACHE_RAM=1024

# Legacy PyTorch backend (CUDA/CPU) for raw logits scoring with Qwen3.5 weights:
# FBU_BACKEND=torch
FBU_PORT=8767
FBU_HEADLESS=1
FBU_LOCALE=en-US
# Planning: auto = decompose multi-step goals into subgoals (Claude-Code-like task
# list); 1 = always plan; 0 = never (full-goal single pass).
FBU_PLAN=auto
# Max browser actions per task (step budget).
FBU_MAX_STEPS=60
# llama-server context window (tokens). Bing-style pages with many candidates
# need headroom; requests that still overflow are retried with compacted state.
FBU_LLAMACPP_CTX=16384
# Per-step d1 decision transcript (top candidates, probabilities, timing).
# 1 = show under every step line; 0 = hide (also toggled by /decide in chat).
FBU_STEP_DETAIL=1
# Cap the visible candidate table (decision quality + CPU latency on huge
# pages like bing). Fill/select, buttons and goal-keyword matches survive the
# cap; plain navigation links are dropped first. Floor is 8.
FBU_MAX_CANDIDATES=28
# Stop the task after N consecutive failures to produce a fill value, instead
# of ever typing model meta-text ("None of the above...") into a real field.
FBU_NO_VALUE_LIMIT=3
FBU_REASONING=0
FBU_DECISION_MODE=auto
FBU_SETTLE_MS=150

# Remote-LLM escalation (browser-use-style fallback): when d1 is unsure or stuck,
# a larger LLM on ModelScope API-Inference gives a second opinion or asks you.
# Docs: https://modelscope.cn/docs/model-service/API-Inference/intro
FBU_LLM_API_BASE=https://api-inference.modelscope.cn/v1
FBU_LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
FBU_LLM_API_KEY=ms-d72ed675-91b1-48b1-a495-aed250e1ccf8
FBU_LLM_TIMEOUT=60
FBU_LLM_THINKING=0
# auto = only low-confidence/stuck triggers; on = lower threshold; off = 100% local
FBU_LLM_ESCALATION=auto
FBU_LLM_RESCUE_LIMIT=2
# Max consecutive ASK_LLM consultations with no browser action in between
FBU_ASK_LLM_LIMIT=2
FBU_LLM_CONFIDENCE=auto
